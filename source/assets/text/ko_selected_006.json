  "entries": [
    {
      "id": "JP_INTRO_01_L01",
      "ko": "앗, 저 꾀쟁이 고양이!"
    },
    {
      "id": "JP_INTRO_01_L02",
      "ko": "톰이 정신 못 차리고 또 나타났어."
    },
    {
      "id": "JP_INTRO_01_L03",
      "ko": "이번엔 제리를 꾀어내려고"
    },
    {
      "id": "JP_INTRO_01_L04",
      "ko": "제리의 조카 터피를 납치해서"
    },
    {
      "id": "JP_INTRO_01_L05",
      "ko": "어딘가에 꼭꼭 숨겨 버렸지."
    },
    {
      "id": "JP_INTRO_02_L01",
      "ko": "톰이 놓은 함정과 적들의 공격을"
    },
    {
      "id": "JP_INTRO_02_L02",
      "ko": "피해 나가기는 만만치 않아!"
    },
    {
      "id": "JP_INTRO_02_L03",
      "ko": "터피를 구하려면"
    },
    {
      "id": "JP_INTRO_02_L04",
      "ko": "네 도움이 꼭 필요해!"
    },
    {
      "id": "JP_INTRO_03_L01",
      "ko": "터피가 네 도움을 기다리고 있어!"
    },
    {
      "id": "JP_INTRO_03_L02",
      "ko": "무사히 구해 낼 수 있을까?"
    },
    {
      "id": "JP_INTRO_03_L03",
      "ko": "자, 모험을 시작해 보자!"
    },
    {
      "id": "JP_ENDING_01_L01",
      "ko": "축하해! 정말 잘했어!"
    },
    {
      "id": "JP_ENDING_01_L02",
      "ko": "네 덕분에 터피를"
    },
    {
      "id": "JP_ENDING_01_L03",
      "ko": "무사히 구해 낼 수 있었어."
    },
    {
      "id": "JP_ENDING_01_L04",
      "ko": "톰은 제리를 잡으려고 놓은"
    },
    {
      "id": "JP_ENDING_01_L05",
      "ko": "쥐덫에 되레 자기가 걸려 버렸지!"
    },
    {
      "id": "JP_ENDING_01_L06",
      "ko": "끝"
    }
  ],
